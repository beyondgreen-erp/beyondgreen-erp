[Unit]
Description=beyondGREEN machine poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/beyondgreen/poller.py /etc/beyondgreen/poller.json
Restart=always
RestartSec=15
User=beyondgreen
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
